# Sub Rosa — environment template. Copy to .env and fill with real values.
# NEVER commit a populated .env. No mock values are used anywhere in this project.

# --- Stellar network ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Deployed contract ---
# Leave blank to use the SDK default (reviewed Core v2). Owner-Triggered Reveal
# (protocol 3) testnet is a separate, non-default contract; set it explicitly:
#   ROUND_CONTRACT_ID=CB7VIYY4RQLZG2Y6HLDWB3UKSVOAIDYFZ5TGW5AUBCIPJHTCZV4ZWQFF
ROUND_CONTRACT_ID=

# --- Signer for @sub-rosa/sdk (state-changing calls) ---
# Secret key (S…) of the account that signs & pays. Read-only calls don't need it.
STELLAR_SECRET_KEY=

# --- USDC (Stellar Asset Contract) ---
# testnet issuer: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_SAC=

# --- Sub Rosa x Trustless Work pilot (apps/web) ---
# Copy these VITE_* values to apps/web/.env.local for the browser pilot.
VITE_TRUSTLESS_WORK_BASE_URL=https://dev.api.trustlesswork.com
VITE_TRUSTLESS_WORK_API_VERSION=v1
# Must be the full API key token for the matching Trustless Work network.
VITE_TRUSTLESS_WORK_API_KEY=
VITE_TRUSTLESS_WORK_TRUSTLINE_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VITE_TRUSTLESS_WORK_TRUSTLINE_SYMBOL=USDC
VITE_TRUSTLESS_WORK_TRUSTLINE_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Drand (quicknet) ---
# Validated against a live round before deploy (see services/drand-tools).
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_API_URL=https://api.drand.sh

# --- OpenZeppelin Relayer Channels (optional submitter adapter) ---
# Direct Soroban RPC is the default. If both URL + key are set, SDK callers can
# pass createOzChannelsSubmitterFromEnv() into SubRosaClient({ submitter }).
OZ_CHANNELS_BASE_URL=https://channels.openzeppelin.com/testnet
OZ_CHANNELS_API_KEY=
# Self-hosted Relayer only:
OZ_CHANNELS_PLUGIN_ID=
OZ_CHANNELS_FUND_RELAYER_ID=
OZ_CHANNELS_TIMEOUT_MS=30000

# --- x402 appraisal API ---
X402_APPRAISAL_URL=
# Server runtime (minimal testnet config):
# FACILITATOR_SECRET=S…
# PAY_TO=G…
# X402_NETWORK=stellar:testnet
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# RPC_URL=https://soroban-testnet.stellar.org
# PAYMENT_ASSET=          # defaults to USDC for X402_NETWORK
# PRICE=0.10
# PORT=4021

# --- Keeper (services/keeper) ---
# STELLAR_NETWORK=testnet  # testnet or mainnet; named defaults are validated
# KEEPER_SECRET=S…
# ROUND_CONTRACT_ID=C…
# KEEPER_DRY_RUN=true
# KEEPER_PROTOCOL_VERSION=2 # Core v2 default; use 1 for legacy v1 rounds
# ROUND_ID=1
# WATCH_POLL_MS=15000
# WATCH_ROUND_IDS=1,2,5
# WATCH_FROM=1
# WATCH_MAX_ROUNDS=64

# --- Mainnet launch (value-moving commands) ---
# MAINNET_CONFIRM=SUB_ROSA_MAINNET
# OPERATOR_SECRET=S…        # deployer/seller; signs and pays its own tx fees
# BIDDER_SECRET=S…          # separate bidder; signs and pays its own tx fees
# OPERATOR_IDENTITY=sub-rosa-mainnet-v2-operator # Keychain alias; preferred over secret
# BIDDER_IDENTITY=sub-rosa-mainnet-v2-bidder     # Keychain alias; preferred over secret
# ROUND_CONTRACT_ID=CDQOFNCJE5Z4ZZL76DU5652FOUKJVEIZWHFGCZVWH63UYBGPSZIPC325
# RPC_URL=https://mainnet.sorobanrpc.com
# NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# MAINNET_DRY_RUN=1
# MICRO_BID_STROOPS=
# MICRO_ESCROW_STROOPS=
# DEPLOYMENT_ARTIFACT=artifacts/deployments/core-v2-mainnet.local.json
# SMOKE_ARTIFACT=artifacts/deployments/core-v2-mainnet-smoke.local.json

# Structured receipt export uses the v2 API for v2/v3 records; use 1 for legacy.
RECEIPT_PROTOCOL_VERSION=2
