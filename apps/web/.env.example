# Optional — jury demo works WITHOUT this file (uses embedded DEMO_TRACE).
#
# Vite reads these at BUILD time only (VITE_* prefix). For production:
#   → set the same keys in Vercel / Netlify / Cloudflare "Environment Variables"
#   → then run: pnpm web:build
#
# Local dev: copy to .env.local (gitignored):
#   cp .env.example .env.local

# --- Core v2 partner pilot (proposal + atomic asset auction templates) ---
VITE_STELLAR_NETWORK=testnet
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_CONTRACT_ID=CCOVGOQQZJKZ2R55GRWBLTJTGBAMSHXZVN3ICPG3WRVMLMM6RHISC5OV
VITE_ESCROW_TOKEN_LABEL=XLM

# --- Sub Rosa x Trustless Work testnet pilot ---
# Trustless Work v1 REST builds unsigned XDR; Freighter signs locally; the
# signed XDR is submitted through /helper/send-transaction.
VITE_TRUSTLESS_WORK_BASE_URL=https://dev.api.trustlesswork.com
VITE_TRUSTLESS_WORK_API_VERSION=v1
# Must be the full API key token for the matching Trustless Work network.
VITE_TRUSTLESS_WORK_API_KEY=
# Optional starter values for the Trustless Work handoff form.
VITE_TRUSTLESS_WORK_TRUSTLINE_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VITE_TRUSTLESS_WORK_TRUSTLINE_SYMBOL=USDC
VITE_TRUSTLESS_WORK_TRUSTLINE_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- ACTA x Sub Rosa credential pilot ---
# Optional override. ACTA Testnet is the default.
VITE_ACTA_BASE_URL=https://api.testnet.acta.build
# Local pilot convenience only. VITE_* values are embedded in the client build,
# so do not use a sensitive or production key here.
VITE_ACTA_API_KEY=

