# Browser-safe publishable key from https://dashboard.pollar.xyz → API Keys.
# Never put a sec_testnet_... secret key in a VITE_ variable.
VITE_POLLAR_PUBLISHABLE_KEY=pub_testnet_replace_me

# Optional. Leave blank to use Pollar's hosted SDK API.
VITE_POLLAR_BASE_URL=

# Optional. Defaults to the official Stellar testnet Soroban RPC.
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
