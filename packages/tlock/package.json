{
  "name": "@sub-rosa/tlock",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Off-chain seal for Sub Rosa: tlock encrypt/decrypt to a Drand round + auditor identity blob, byte-compatible with the Round contract.",
  "keywords": [
    "drand",
    "tlock",
    "privacy",
    "timelock-encryption",
    "commit-reveal",
    "stellar",
    "soroban"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/karagozemin/Sub-Rosa.git",
    "directory": "packages/tlock"
  },
  "license": "MIT",
  "homepage": "https://github.com/karagozemin/Sub-Rosa/tree/main/packages/tlock#readme",
  "bugs": {
    "url": "https://github.com/karagozemin/Sub-Rosa/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sub-rosa-recover-identities": "./dist/recover-identities.cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test src/commitment.test.ts src/payload.test.ts src/auditor.test.ts src/auditor-recovery-cli.test.ts src/bls.test.ts src/seal.test.ts src/freshness.test.ts src/quicknet.test.ts",
    "test:quicknet": "node --import tsx --test src/quicknet.test.ts",
    "test:unit": "node --import tsx --test src/commitment.test.ts src/payload.test.ts src/auditor.test.ts src/auditor-recovery-cli.test.ts src/bls.test.ts src/freshness.test.ts src/quicknet.test.ts",
    "test:seal": "node --import tsx --test src/seal.test.ts",
    "recover:identities": "node --import tsx src/recover-identities.cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "drand-client": "^1.4.2",
    "tlock-js": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
