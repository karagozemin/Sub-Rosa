{
  "name": "@sub-rosa/round-bindings",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Generated TypeScript bindings for the Sub Rosa Round contract (spec-accurate; do not hand-edit).",
  "license": "MIT",
  "homepage": "https://github.com/karagozemin/Sub-Rosa/tree/main/packages/round-bindings#readme",
  "bugs": {
    "url": "https://github.com/karagozemin/Sub-Rosa/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karagozemin/Sub-Rosa.git",
    "directory": "packages/round-bindings"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/event-snapshot.d.ts",
      "import": "./dist/event-snapshot.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/event-snapshot.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
